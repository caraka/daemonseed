#!/usr/bin/env bash
# daemonseed pre-push hook — the pre-flight group of the Definition-of-Done
# gate, which is defined once in `xtask` (`RELEASE_GATE_STEPS`).
#
# Installed by `cargo xtask install-hooks`. The two suite groups are
# `dev-suite`, which lints the windowed GUI and runs the dev-profile test
# suite, and `release-suite`, which runs the release-profile suite; CI runs all
# three groups on every pull request and on `main`. `git push --no-verify`
# skips this hook, and a skip is justified in the commit body. The full gate is
# `cargo xtask gate`. Every gate run ends by deleting the binaries its steps
# linked into `target/`, so the next build of one relinks it.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

exec cargo xtask gate --group preflight
