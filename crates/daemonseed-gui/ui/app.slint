// daemonseed-gui — shell (Slint, software renderer).
//
// Round 1 ported the three-zone shell from the perf spike. Round 2/3 made it
// interactive + wired the public Lobby to real networking. Round 4 adds **circle
// plumbing**: Join-a-circle and New-circle overlays (the action-registry surfaces),
// a rail empty-state ("No circles yet"), and the materialize flow. Circles are
// materialized-but-MUTE this round (no networking) — Round 5 plugs the net path
// into the per-circle net contract the state layer now carries.
//
// Visual language per brief: dark 4-step surface ladder, GRAYSCALE chrome, ONE
// teal accent (primary action + E2EE "sealed" tint). Trust marker is a LABELED
// PILL, never a dot (brief #5). Entropy/key/derivation words never appear; a quiet
// "Looks strong" stands in for any meter (brief #34, D3 — numbers HIDDEN).

// Default UI font for the software renderer (which has no system-font access at
// runtime). DejaVu Sans gives a complete glyph set — the password mask ● (U+25CF)
// and the disclosure carets ▶/▾ (U+25B6/U+25BE) — that the prior bundled font
// lacked. Vendored unmodified; see fonts/DejaVuSans-LICENSE.txt.
import "fonts/DejaVuSans.ttf";

struct CircleData {
    name: string,
    sub: string,
    initial: string,
    pinned: bool,
    unread: bool,
}

struct MsgData {
    who: string,
    text: string,
    mine: bool,
}

// One flattened row of the public-share browse tree (Shares tab). `kind`: 0 share
// (depth-0 root), 1 folder, 2 file. Built by Rust from `share_browser::Row`; the
// model is replaced on every refresh, so the `for` re-renders — no `if`-teardown.
struct ShareRow {
    id: int,
    depth: int,
    label: string,
    size: string,
    kind: int,
    expandable: bool,
    expanded: bool,
    mine: bool,
    loading: bool,
}

struct ActionData {
    label: string,
    shortcut: string,
}

// One row of the Publish overlay's "Your live shares" list (commit 3). `id` is the
// server-assigned opaque share id — passed back verbatim to `unpublish-share`.
struct MyShareRow {
    id: string,
    name: string,
    files: int,
}

// One live Lobby roster row (#75). `name` is the member's display handle; the
// `#12hex` verification fingerprint (ISC-C4 binding to the verified pubkey) is
// carried per-row but shown only ON HOVER (caraka 2026-06-24 — names stay short).
// Rust replaces the whole `roster` model on every presence change, so the `for`
// re-renders without an `if`-teardown (partial_renderer item-tree safety).
struct RosterRow {
    name: string,
    fingerprint: string,
}

// One verified announcement row (#91, ISC-S7). `topic`/`body` are the inert
// decoded post fields, rendered verbatim; `ts` is the signing wall-clock formatted
// to a short UTC caption by Rust. Rust replaces the whole `announcements` model on
// each refresh, so the `for` re-renders without an `if`-teardown (only verified
// posts are ever in the model — ISC-A-S3).
struct AnnouncementRow {
    topic: string,
    body: string,
    ts: string,
}

component RailRow inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <string> initial;
    in property <bool> selected: false;
    in property <bool> pinned: false;
    in property <bool> unread: false;   // #64: new-message dot for an unfocused room
    callback clicked;
    height: 54px;
    border-radius: 8px;
    background: selected ? #141517 : transparent;
    TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding: 8px; spacing: 10px;
        Rectangle {
            width: 34px; height: 34px; border-radius: 17px; background: #1b1d20;
            border-width: 1px; border-color: #ffffff14;
            Text { text: root.initial; color: #8b93a1; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            alignment: center; spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.name; color: #d6dae1; font-size: 14px; vertical-alignment: center; }
                if root.pinned : Text { text: "PINNED"; color: #555d6a; font-size: 9px; vertical-alignment: center; }
            }
            Text { text: root.sub; color: #5b6472; font-size: 12px; }
        }
        Rectangle { }
        // #64: unread dot — unseen activity in a room you're not focused on. The
        // active row never shows it (state clears unread on focus), but gate on
        // !selected too so it can never linger on the focused row.
        if root.unread && !root.selected : Rectangle {
            width: 8px; height: 8px; border-radius: 4px; background: #4a9d8e;
        }
    }
}

component SealedPill inherits Rectangle {
    width: 80px; height: 20px; border-radius: 10px;
    background: #11302b; border-width: 1px; border-color: #1f4d45;
    Text { text: "encrypted"; color: #6fb3a4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
}

// The quiet "Looks strong" reassurance (brief D3 — a calm cue, NEVER a numeric
// meter) is now a stable computed Text in each overlay's status row (a dedicated
// `StrongPill` component was removed: toggling it via `if` mutated the item tree
// mid-edit and crashed the partial_renderer with "RefCell already borrowed").

component MsgBubble inherits Rectangle {
    in property <string> who;
    in property <string> text;
    in property <bool> mine;
    HorizontalLayout {
        alignment: root.mine ? end : start;
        Rectangle {
            // #86: cap the bubble at ~72% of the row so a long message wraps instead of
            // clipping; with no fixed height the bubble grows to fit the wrapped text.
            max-width: root.width * 0.72;
            border-radius: 10px;
            // #85: others get the readable green bubble (the ones you need to read);
            // your own messages get the dark bubble (no need to re-read what you wrote).
            background: root.mine ? #141517 : #15302b;
            border-width: 1px;
            border-color: root.mine ? #ffffff10 : #1f4d45;
            VerticalLayout {
                padding: 8px; spacing: 2px;
                Text { text: root.who; color: root.mine ? #8b93a1 : #6fb3a4; font-size: 11px; }
                Text { text: root.text; color: #d6dae1; font-size: 13px; wrap: word-wrap; }
            }
        }
    }
}

// One live-roster row (#75): the member's display name, calm/grayscale, no
// decorator (the roster IS the presence signal — no dot/badge/"last seen"). The
// `#12hex` fingerprint is the on-demand verification cue: it appears ONLY while the
// row is hovered, via a COMPUTED text (never an `if`), so hover can't mutate the
// item tree (the partial_renderer "RefCell already borrowed" crash).
component RosterRowView inherits Rectangle {
    in property <string> name;
    in property <string> fingerprint;
    // Tall enough to hold the name AND the on-hover fingerprint line WITHIN the
    // row's own bounds, so the hex can never overlap the next member's name
    // (caraka felt-test 2026-06-24). Accessibility pass: larger, higher-contrast
    // text for low-vision readability.
    height: 46px; border-radius: 6px;
    background: touch.has-hover ? #1b1d20 : transparent;
    touch := TouchArea { }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px;
        VerticalLayout {
            alignment: center; spacing: 2px;
            Text { text: root.name; color: #eef1f5; font-size: 16px; overflow: elide; }
            // verification fingerprint — revealed on hover, its OWN line inside the
            // 46px row (never floats over the next row); brighter than chrome so it
            // stays legible. Empty when not hovered (computed, never an `if`).
            Text { text: touch.has-hover ? root.fingerprint : ""; color: #9aa3b0; font-size: 12px; }
        }
        Rectangle { }
    }
}

// One announcement row (#91): a calm card with the topic, the wrapping body, and a
// muted UTC timestamp caption. Read-only (display-only — composing is #92); reuses
// the chat-bubble idiom (the readable green accent on the topic, dark card body).
component AnnouncementRowView inherits Rectangle {
    in property <string> topic;
    in property <string> body;
    in property <string> ts;
    border-radius: 10px;
    background: #101113;
    border-width: 1px;
    border-color: #ffffff10;
    VerticalLayout {
        padding: 10px; spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.topic; color: #6fb3a4; font-size: 13px; font-weight: 600; vertical-alignment: center; }
            Rectangle { }
            Text { text: root.ts; color: #5b6472; font-size: 11px; vertical-alignment: center; }
        }
        Text { text: root.body; color: #d6dae1; font-size: 13px; wrap: word-wrap; }
    }
}

// One row of the public-share browse tree: indented by depth, a disclosure caret
// for expandable rows (share / non-empty folder), the node's own segment, and — on
// the right — a "you" tag (your own share), a quiet "loading…" while a preview is in
// flight, or a file's size. The whole row toggles when expandable; a file is inert
// here (right-click Download is commit 2). Calm/grayscale per the brief: one teal cue
// (the "you" tag), folders carry a trailing slash, no icons.
component ShareTreeRow inherits Rectangle {
    in property <ShareRow> node;
    callback toggled(int);
    callback downloadable(int);
    height: 30px;
    background: touch.has-hover ? #101113 : transparent;
    touch := TouchArea {
        // Left-click toggles an expandable row; right-click downloads the node
        // (file -> itself, folder -> its files, share -> all). OS-browser muscle
        // memory: right-click > Download to…
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.downloadable(root.node.id);
            }
        }
        clicked => { if (root.node.expandable) { root.toggled(root.node.id); } }
    }
    HorizontalLayout {
        padding-left: 10px + root.node.depth * 18px;
        padding-right: 14px; spacing: 8px;
        // disclosure caret (blank for a file / empty folder). Now that the bundled
        // DejaVu Sans default font carries the geometric shapes, the caret uses the
        // proper chevrons ▾ (expanded) / ▶ (collapsed) instead of the ASCII v / >.
        Text {
            width: 12px;
            text: root.node.expandable ? (root.node.expanded ? "▾" : "▶") : "";
            color: #8b93a1; font-size: 12px; vertical-alignment: center;
        }
        Text {
            text: root.node.kind == 1 ? root.node.label + "/" : root.node.label;
            color: root.node.kind == 0 ? #e4e8ee : root.node.kind == 1 ? #cfd5dd : #aeb6c2;
            font-size: root.node.kind == 0 ? 14px : 13px;
            vertical-alignment: center;
        }
        // "you" — the one teal cue, computed (never an `if`) so it can't mutate the
        // item tree; empty string when it does not apply.
        Text {
            text: (root.node.kind == 0 && root.node.mine) ? "you" : "";
            color: #6fb3a4; font-size: 11px; vertical-alignment: center;
        }
        Rectangle { }
        Text {
            text: root.node.loading ? "loading…" : root.node.size;
            color: #5b6472; font-size: 12px; vertical-alignment: center;
        }
    }
}

// A calm pill button (overlay CTAs / secondary actions). `primary` = the one teal
// accent; otherwise a muted surface-ladder button.
component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <length> w: 130px;
    callback clicked;
    width: root.w; height: 38px; border-radius: 9px;
    background: root.primary ? #4a9d8e : #141517;
    border-width: root.primary ? 0px : 1px; border-color: #ffffff14;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: root.primary ? #06120f : #cfd5dd;
        font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
    }
}

// Inheriting TouchArea makes the WHOLE label clickable (its built-in `clicked`
// fires anywhere over the content). Content-hugging width is preserved.
component TabLabel inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: root.active ? #d6dae1 : #5b6472; font-size: 13px; horizontal-alignment: center; }
        Rectangle { height: 2px; background: root.active ? #6b7280 : transparent; border-radius: 1px; }
    }
}

// A text-entry field wrapped in a right-click context menu (Cut / Copy / Paste /
// Select all) — #67. The menu items invoke the wrapped TextInput's OWN built-in
// clipboard functions (cut/copy/paste/select-all), which use Slint's backend
// (winit) clipboard. That backend keeps X11 selection ownership correct, unlike a
// transient `arboard::Clipboard` that drops ownership on drop — so Copy/Cut need
// NO hand-rolled clipboard write and dodge the X11-ownership felt-test risk. The
// pattern mirrors Slint's own LineEditBase. The wrapped input fills the wrapper,
// so left-click still focuses/edits it; only right-click raises the menu.
//
// `custom-paste` routes the Paste item to `paste-requested` instead of the field's
// own paste — used by the Join field to keep the #63 read_clipboard_text path
// (clipboard read + strength refresh + refocus) live and unregressed.
component MenuTextInput inherits Rectangle {
    in-out property <string> text;
    in property <bool> single-line: true;
    in property <length> font-size: 13px;
    in property <TextWrap> wrap: TextWrap.no-wrap;
    in property <InputType> input-type: InputType.text;
    in property <bool> custom-paste: false;
    callback accepted();
    callback edited();
    callback paste-requested();
    // `focus` is a built-in element member, so the passthrough is named
    // `focus-input` to avoid colliding with it; call sites use `.focus-input()`.
    public function focus-input() { ti.focus(); }
    public function select-all() { ti.select-all(); }
    public function copy() { ti.copy(); }
    // min-width 1px: a TextInput narrower than 1px (or clipped to it) can't be
    // focused (mirrors Slint's own LineEditBase). forward-focus so a click on the
    // wrapper's padding still lands in the input.
    min-width: 1px;
    forward-focus: ti;
    // A real builtin ContextMenuArea (NOT inherited — the menu-lowering pass
    // requires a builtin here, not a user component), with the field as content
    // and the right-click menu as its Menu. Mirrors LineEditBase.
    ContextMenuArea {
        Menu {
            MenuItem { title: "Cut"; activated => { ti.cut(); } }
            MenuItem { title: "Copy"; enabled: !root.text.is-empty; activated => { ti.copy(); } }
            MenuItem {
                title: "Paste";
                activated => {
                    if (root.custom-paste) { root.paste-requested(); } else { ti.paste(); }
                }
            }
            MenuItem { title: "Select all"; enabled: !root.text.is-empty; activated => { ti.select-all(); } }
        }
        ti := TextInput {
            width: 100%; height: 100%;
            text <=> root.text;
            single-line: root.single-line;
            font-size: root.font-size;
            color: #d6dae1;
            wrap: root.wrap;
            input-type: root.input-type;
            vertical-alignment: center;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

export component AppWindow inherits Window {
    // Resizable: prefer the 1100x680 default but let the window adopt the real
    // surface (down to a small floor) so the shell + auth overlays reflow instead
    // of being clipped. A fixed width/height made the surface non-reflowing, which
    // on small/software-rendered surfaces pushed the passphrase field off-screen.
    preferred-width: 1100px; preferred-height: 680px;
    min-width: 720px; min-height: 480px;
    background: #07080a;
    // Bundle the UI font so the software renderer draws a complete glyph set
    // (password mask ●, carets ▶/▾) regardless of the host's fonts. Pairs with
    // the `import "fonts/DejaVuSans.ttf"` above.
    default-font-family: "DejaVu Sans";
    // App/window icon (taskbar + title bar). Rasterized from the AppImage's
    // scalable placeholder (packaging/appimage/daemonseed-gui.svg) so the
    // windowed app and the AppImage share one mark; aesthetic refinement is a
    // separate pass. The .slint compiler bundles this asset into the binary.
    title: "Daemonseed";
    icon: @image-url("daemonseed-gui.png");

    in property <[CircleData]> circles;
    in-out property <int> active: 0;          // SOLE writer is Rust (out-of-range guard)
    in-out property <int> active-tab: 0;      // 0 = Chat, 1 = Shares, 2 = Circle shares
    in property <string> header-name;
    in property <string> header-sub;
    in property <[MsgData]> messages;
    // Live Lobby roster (#75) — Rust-replaced on every presence change. Holds only
    // OTHER live members (own presence is implicit, filtered net-side); empty ⇒ the
    // "No one else here yet" empty-state. Bound to the Lobby for this increment;
    // circle presence is #77.
    in property <[RosterRow]> roster;

    // ── Announcements + MOTD pane (#91) — display-only, scoped to the connected
    // relay. `motd` is the inert verbatim MOTD ("" ⇒ hide the MOTD area, ISC-S9);
    // `announcements` are the client-re-verified posts; `announce-status` carries a
    // fetch error / hint line. The pane is reachable via the Ctrl-K palette + tab.
    in property <string> motd;
    in property <[AnnouncementRow]> announcements;
    in-out property <string> announce-status;
    in property <string> announcements-empty-hint: "No announcements from this relay yet.";
    callback announcements-tab-opened();
    // ── Signer-gated composer (#92 / D3) — shown ONLY when the local stable
    // identity key is on the relay's published whitelist. `can-compose` is set
    // by the PublicSpaceSnapshot (never by typing), so gating the composer
    // subtree with an `if` is safe. A non-signer never sees these affordances
    // (read-only pane). `set-motd` signs+uploads the MOTD (UploadMotd, #89);
    // `upload-announcement(topic, body)` signs+uploads a post (UploadPost). The
    // net actor signs with the STABLE identity key; a plaintext-rule rejection or
    // refused upload returns via `announce-status`.
    in property <bool> can-compose;
    in-out property <string> compose-motd;
    in-out property <string> compose-topic;
    in-out property <string> compose-body;
    callback set-motd(string);
    callback upload-announcement(string, string);

    // ── Shares tab (public-share browse tree) ──
    // `share-rows` is the flattened, render-ready tree (Rust rebuilds it on refresh /
    // expand / manifest-load). `share-status` is a quiet right-of-title line (errors,
    // counts). `shares-empty-hint` is the centered empty-state copy.
    in property <[ShareRow]> share-rows;
    in property <string> share-status;
    in property <string> shares-empty-hint: "No shares yet — Refresh to see what daemons are sharing.";
    // Download meter (commit 2), in the rail footer so it persists across tabs — a
    // download keeps running while you return to Chat. Deliberately simple: a label +
    // a fraction bar, no per-file detail (a full downloads pane is a later idea).
    // `download-label` empty = hidden; `download-progress` is 0..1.
    in property <string> download-label;
    in property <float> download-progress: 0.0;
    in-out property <string> draft;           // live composer text, read by Rust on switch
    in-out property <length> scroll-y: 0px;   // Flickable viewport-y (negative when scrolled)
    // #84/#86: the chat transcript's real laid-out content height, pushed up from inside
    // the chat Flickable. Bubbles are variable-height since #86, so a fixed per-message
    // stride no longer measures the content; 0px until the chat tab first instantiates.
    property <length> chat-content-h: 0px;
    // #84: true when the chat transcript is scrolled to (or near) its bottom. Read by
    // Rust BEFORE a new message lands so it can decide stick-to-bottom vs hold-position.
    // `chat-area` is the always-present content wrapper (its height == the chat
    // Flickable's visible height).
    out property <bool> chat-at-bottom:
        root.scroll-y <= -(root.chat-content-h - chat-area.height) + 24px;
    in-out property <bool> sheet-open: false;
    // #36 circle-detail name vectors, set from `GuiState` for the active circle (all
    // blank for the Lobby, which has no net contract → the vector rows hide). The
    // three are distinct on purpose: `circle-name` is the chosen display name;
    // `circle-relay-label` is the relay-scoped adj-noun label (matches only between
    // members on the SAME relay); `circle-fingerprint` is the relay-independent
    // `#<12hex>` — the universal out-of-band verification vector.
    in property <string> circle-name;
    in property <string> circle-relay-label;
    in property <string> circle-fingerprint;
    // #115 circle-phrase reveal (evil-maid-gated) + leave-circle confirm. The phrase
    // is the circle's shared secret, so it is revealed ONLY after Rust verifies the
    // unlock passphrase: `circle-phrase-revealed` is "" until then. Cleared whenever
    // the sheet closes / the active circle changes, so a revealed phrase never lingers.
    in property <string> circle-phrase-revealed;
    in-out property <bool> phrase-prompt-open: false;
    in-out property <string> phrase-prompt-pass;
    in property <string> phrase-prompt-error;
    in-out property <bool> leave-confirm-open: false;
    in-out property <bool> palette-open: false;
    in property <[ActionData]> actions;

    // Round-4 circle-plumbing surfaces.
    in-out property <bool> join-open: false;       // Join-a-circle overlay visible
    in-out property <bool> new-open: false;        // New-circle overlay visible
    in-out property <bool> about-open: false;      // About overlay visible (#59)
    // #66 rename-identity overlay (Ctrl-K → "Rename identity"). `rename-name` is the
    // editable display name (prefilled with the current handle, blank for a nameless
    // profile — the #65 recovery path). `rename-error` is an inline validation/persist
    // failure line; non-empty keeps the overlay open.
    in-out property <bool> rename-open: false;     // Rename-identity overlay visible
    in-out property <string> rename-name;          // editable display name (two-way to Rust)
    in property <string> rename-error;             // Rust-set: invalid-name / persist-failure line
    // Commit-3 publish surface: the Publish overlay (a manage-your-shares sheet).
    in-out property <bool> publish-open: false;    // Publish overlay visible
    in-out property <string> publish-name;         // optional share name (blank → folder basename)
    in property <[MyShareRow]> my-shares;          // Rust-set: shares published this session
    in-out property <string> publish-status;       // overlay feedback: "Publishing…" / result / error
    in-out property <string> connect-notice;       // tab-independent banner: "Restored N shares…" on connect
    in-out property <bool> desktop-prompt-open: false; // first-run "add to applications?" prompt (AppImage only)
    in-out property <string> desktop-prompt-status;    // result line inside that prompt
    in-out property <string> join-phrase;          // live Join phrase (two-way to Rust)
    in property <bool> join-phrase-strong: false;  // Rust-set: estimate_circle().is_circle_green()
    in-out property <string> new-phrase;           // generated default; EDITABLE (two-way to Rust)
    in property <bool> new-phrase-strong: true;    // Rust-set: estimate_circle().is_circle_green() (generated ⇒ strong)
    in-out property <bool> new-copied: false;      // set on Copy → shows a "copied" confirmation
    in property <bool> only-lobby: true;           // Rust-set: only the pinned Lobby exists → empty-state

    // Real-networking status (round-3): driven by the net actor's events.
    in-out property <string> connection-status: "connecting…";
    in property <string> app-version;                  // Rust-set release version (#59 readout)
    // #66: the user's own live display handle (`name#hash`, or the floor `#hash` when
    // nameless). Set from `GuiState::display_handle()` on enter-main and refreshed
    // IN PLACE on a successful rename, so the rail identity line reflects the new name
    // without a reload. Empty on the ephemeral (no-profile) path.
    in-out property <string> my-handle;
    in-out property <bool> connected: false;

    callback switch-circle(int);
    // Composer Send (or Enter) — carries the draft. Lobby → real sealed SendRoom;
    // a materialized circle → the Round-5 SendCircle seam (local-echo stub).
    callback send-message(string);

    // Shares-tab callbacks (commit 1: browse). `refresh-shares` re-lists the relay
    // catalog (Rust reconciles by share_id, preserving open folders). `toggle-share-
    // node(id)` expands/collapses a row — Rust lazily fetches a share's manifest on
    // first expand. `shares-tab-opened` fires an immediate refresh when the tab is
    // selected (the ~3s auto-poll while it stays open is driven Rust-side).
    callback refresh-shares();
    callback toggle-share-node(int);
    callback shares-tab-opened();
    // Right-click a tree node (commit 2): Rust resolves it to a download target
    // (file -> itself, folder -> its files, share -> all), opens the native folder
    // picker off-thread, and fires ConfirmFetch to the chosen destination.
    callback download-node(int);

    // Publish callbacks (commit 3). `open-publish` raises the Publish overlay (from the
    // Shares header or palette). `submit-publish(name)` opens the native folder picker
    // off-thread and publishes the chosen folder under `name` (blank → basename).
    // `unpublish-share(id)` stops serving a share you published this session.
    callback open-publish();
    callback submit-publish(string);
    callback unpublish-share(string);
    callback desktop-integrate();          // first-run: register the .desktop + icon
    callback desktop-dismiss(bool);        // close the prompt; true = "don't ask again"

    // Round-4 callbacks. `open-*` raise the overlays from EITHER surface (rail
    // empty-state or palette — action registry → two surfaces). `join-phrase-edited`
    // lets Rust recompute the hidden strength on each keystroke. `submit-*`
    // materialize. `reroll-new` regenerates the diceware phrase.
    callback open-join();
    callback open-new();
    // #66: `open-rename` raises the rename-identity overlay (palette → main shell),
    // prefilled by Rust with the current display name. `submit-rename(name)` validates
    // + re-seals + updates the live handle; on an invalid name Rust sets `rename-error`
    // and leaves the overlay open.
    callback open-rename();
    callback submit-rename(string);
    callback focus-rename-input();
    // #115: reveal-phrase(passphrase) → Rust verifies; on success sets
    // circle-phrase-revealed, else sets phrase-prompt-error. copy-phrase copies the
    // revealed phrase to the clipboard. leave-circle forgets the active circle (drops
    // it from the rail + the profile blob). hide-phrase clears the revealed phrase.
    callback reveal-phrase(string);
    callback copy-phrase();
    callback leave-circle();
    callback hide-phrase();
    callback focus-phrase-pass-input();
    focus-rename-input => { rename_name_input.focus-input(); }
    focus-phrase-pass-input => { phrase_pass_input.focus-input(); }
    callback join-phrase-edited(string);
    callback submit-join(string);
    callback reroll-new();
    callback submit-new(string);
    // Recompute the (hidden) strength when the user edits the generated phrase, so
    // an edited-weak phrase loses the "Looks strong" pill and is blocked on submit.
    callback new-phrase-edited(string);
    // Autofocus the composer after a rail switch so the user can type immediately
    // (caraka note 2026-06-15). Guarded to the Chat tab; Rust invokes it on switch.
    callback focus-composer();
    focus-composer => { if (root.active-tab == 0) { composer.focus-input(); } }
    // Any switch INTO the Chat tab (TabLabel click, post-join, or a programmatic
    // Rust set) refocuses the composer. composer is always-instantiated (visible-
    // gated, not `if`-gated), so focusing here is timing-safe.
    changed active-tab => { if (root.active-tab == 0) { root.focus-composer(); } }
    // Focus the Join phrase field when the overlay opens, so typing / Ctrl-V lands
    // without needing a click (the VM software-render path can drop pointer clicks).
    callback focus-join-input();
    focus-join-input => { join_phrase_input.focus-input(); }
    // Right-click "paste" into the Join phrase field (#63). Handled in Rust
    // (clipboard read), which sets `join-phrase`, refreshes strength, and refocuses.
    callback paste-into-join();

    // ── Round-6: persistent identity — first-start + unlock auth gate ──
    //
    // `screen` selects the top-level surface: "first-start" (enrollment wizard),
    // "unlock" (daily-login passphrase), or "main" (the shell). Default "main" so the
    // offscreen render + the existing flows are unchanged unless Rust routes away.
    // The wizard advances by `fs-step` (0 passphrase → 1 mnemonic → 2 confirm → 3
    // name); Rust owns the FirstStart state machine and advances the step only when a
    // core step actually succeeds, so the UI can't get ahead of the crypto.
    in-out property <string> screen: "main";
    in-out property <int> fs-step: 0;
    in-out property <string> fs-passphrase;            // two-way; the chosen unlock passphrase
    in-out property <string> fs-passphrase-confirm;    // two-way; the re-entry that must match fs-passphrase (no recovery yet ⇒ a typo locks the id out)
    in property <bool> fs-passphrase-strong: false;    // Rust-set: estimate().is_session_green()
    in property <string> fs-mnemonic;                  // Rust-set: the 24-word recovery phrase
    in-out property <string> fs-confirm-1;             // two-way; C34 type-back word 1 of 3 (own field, ISC-C34)
    in-out property <string> fs-confirm-2;             // two-way; C34 type-back word 2 of 3
    in-out property <string> fs-confirm-3;             // two-way; C34 type-back word 3 of 3
    in property <string> fs-typeback-prompt;           // Rust-set: "Type words #4, #12 and #22 …" (C34)
    in-out property <string> fs-name;                  // two-way; chosen display name
    in-out property <string> unlock-passphrase;        // two-way; daily-login passphrase
    in property <string> auth-error;                   // Rust-set: weak / mismatch / wrong-passphrase line

    // Recompute the (hidden) passphrase strength on each keystroke (session floor).
    callback fs-passphrase-edited(string);
    // Step 0 → 1: Rust runs FirstStart::initialize (gates strength, generates the
    // mnemonic). On success it sets fs-mnemonic + advances; on a weak passphrase it
    // sets auth-error and stays.
    callback fs-passphrase-next();
    // Step 1 → 2: "I've saved it" — Rust advances + defers focus to the confirm field.
    callback fs-saved-next();
    // Step 2 → 3: Rust pre-checks the C34 type-back answers; on match it advances,
    // else re-issues a fresh challenge + auth-error.
    callback fs-confirm-next();
    // Step 3 finish: Rust finalizes with the display name, persists the profile,
    // enters "main", and connects under the new identity.
    callback fs-finish(string);
    // Unlock: Rust opens the blob under the passphrase; wrong → auth-error, right →
    // restore + enter "main" + connect under the persisted handle.
    callback unlock-submit(string);
    // Focus the active auth field. Invoked DEFERRED from Rust (a 0ms single-shot,
    // never from `init` — init-focus re-enters the property graph and panics) after
    // routing to an auth screen. The fields live in `visible:`-toggled overlays
    // (always instantiated), so these ids are reachable here, unlike an `if` subtree.
    callback focus-auth();
    focus-auth => {
        if (root.screen == "unlock") { unlock_input.focus-input(); }
        if (root.screen == "first-start" && root.fs-step == 0) { fs_pass_input.focus-input(); }
        // Step 1 (mnemonic) is a read-and-save step — no field to focus. Steps 2/3
        // are entry fields, so focus them on (re)entry the same way step 0 is.
        if (root.screen == "first-start" && root.fs-step == 2) { fs_confirm_1.focus-input(); }
        if (root.screen == "first-start" && root.fs-step == 3) { fs_name_input.focus-input(); }
    }

    // Global shortcut host: wraps the WHOLE UI (main + overlays) so a key event from
    // any focused field bubbles up here — Ctrl-K kept dying once focus moved into an
    // overlay field that sat outside the scope (caraka, DS2). Grabs focus on init so
    // the shortcut works before anything else is focused. Ctrl-K TOGGLES the palette;
    // Escape closes the palette / overlays. The "Ctrl+K commands" rail row also opens it.
    key-host := FocusScope {
        width: 100%; height: 100%;
        init => { key-host.focus(); }
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "k") {
                root.palette-open = !root.palette-open;
                return accept;
            }
            // Direct keyboard-first shortcuts (match the palette labels). They bubble
            // up here from a focused field that rejects them.
            if (event.modifiers.control && event.text == "n") {
                root.open-new();
                return accept;
            }
            if (event.modifiers.control && event.text == "j") {
                root.open-join();
                return accept;
            }
            if (event.modifiers.control && event.text == "l") {
                root.switch-circle(0);
                return accept;
            }
            // Enter advances the "I've saved it" recovery-phrase step. Step 1 (mnemonic
            // display) has no input field to carry an `accepted`, so nothing is focused
            // and the keypress bubbles up here — mirror the per-field Enter-submit.
            if (event.text == Key.Return && root.screen == "first-start" && root.fs-step == 1) {
                root.fs-saved-next();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.palette-open = false;
                root.join-open = false;
                root.new-open = false;
                root.about-open = false;
                root.rename-open = false;
                root.focus-composer();
                return accept;
            }
            return reject;
        }
    HorizontalLayout {
        // ── LEFT: circle rail ──
        Rectangle {
            width: 256px; background: #0d0e10;
            VerticalLayout {
                padding: 10px; spacing: 4px;
                Rectangle {
                    height: 42px;
                    VerticalLayout { padding-left: 6px; padding-right: 6px; alignment: center;
                        Text { text: "daemonseed"; color: #aeb6c2; font-size: 16px; }
                        // #66: the user's own live identity handle, refreshed in place on
                        // rename. `visible:` (not `if`) so a rename never mutates the tree.
                        Text { text: root.my-handle; visible: root.my-handle != ""; color: #5b6472; font-size: 11px; }
                    }
                }
                for c[i] in root.circles : RailRow {
                    name: c.name; sub: c.sub; initial: c.initial; pinned: c.pinned;
                    unread: c.unread;
                    selected: i == root.active;
                    clicked => { root.switch-circle(i); }
                }

                // Empty-state: only the pinned Lobby exists (brief lean, ISC-31).
                // Mouse-home launch surfaces, mirrored by the palette rows.
                if root.only-lobby : Rectangle {
                    height: 96px;
                    VerticalLayout {
                        padding: 8px; spacing: 8px; alignment: start;
                        Text { text: "No circles yet"; color: #8b93a1; font-size: 13px; }
                        Text { text: "Enter a phrase you were given, or start a new one."; color: #5b6472; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            PillButton { label: "New circle"; primary: true; w: 108px; clicked => { root.open-new(); } }
                            PillButton { label: "Join"; w: 72px; clicked => { root.open-join(); } }
                        }
                    }
                }

                // Persistent entry once circles exist — the empty-state's buttons
                // vanish with `only-lobby`, so adding a SECOND circle needs an
                // always-present surface (felt-test gap, caraka 2026-06-15).
                if !root.only-lobby : HorizontalLayout {
                    padding: 4px; spacing: 8px;
                    PillButton { label: "+ New circle"; primary: true; w: 120px; clicked => { root.open-new(); } }
                    PillButton { label: "Join"; w: 64px; clicked => { root.open-join(); } }
                }

                Rectangle { }
                // Download meter (commit 2): a label + fraction bar, shown only while
                // a download is in flight / just finished (`download-label` non-empty).
                // Lives in the rail so it survives a return to Chat. Simple by design.
                if root.download-label != "" : Rectangle {
                    height: 36px;
                    VerticalLayout {
                        padding: 6px; spacing: 4px; alignment: center;
                        Text { text: root.download-label; color: #8b93a1; font-size: 11px; overflow: elide; }
                        Rectangle {
                            height: 4px; border-radius: 2px; background: #1b1d20;
                            Rectangle {
                                x: 0px; height: 4px; border-radius: 2px;
                                width: parent.width * root.download-progress;
                                background: #4a9d8e;
                            }
                        }
                    }
                }
                // Footer: the Ctrl+K hint (click opens the palette) on the left, the
                // always-visible release version on the right (#59) — the in-app
                // readout testers need; reads the same `app-version` property as the
                // auth screens. One row, so it can't clip the window's bottom edge.
                Rectangle { height: 22px;
                    TouchArea { clicked => { root.palette-open = true; } }
                    HorizontalLayout { padding: 6px; spacing: 6px;
                        Text { text: "Ctrl+K   commands"; color: #8b93a1; font-size: 13px; vertical-alignment: center; }
                        Rectangle { }
                        Text { text: root.app-version; color: #5b6472; font-size: 12px; vertical-alignment: center; }
                    } }
            }
        }

        Rectangle { width: 1px; background: #ffffff12; }

        // ── CENTER: header + tab strip + body ──
        Rectangle {
            // Take the space left by the fixed rail + roster, never grow to content:
            // without this a long pasted draft or message sized this column to its
            // content width, pushing the roster off-screen and overflowing the window.
            horizontal-stretch: 1;
            clip: true;
            background: #07080a;
            VerticalLayout {
                Rectangle {
                    height: 58px; background: #101113;
                    HorizontalLayout {
                        padding: 14px; spacing: 10px;
                        VerticalLayout { alignment: center; spacing: 2px;
                            Text { text: root.header-name; color: #e4e8ee; font-size: 16px; }
                            Text { text: root.header-sub; color: #5b6472; font-size: 12px; } }
                        Rectangle { }
                        Text {
                            text: root.connection-status;
                            color: root.connected ? #6fb3a4 : #5b6472;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        // #35: open the Circle-details sheet — per-circle only
                        // (hidden on the Lobby, which has no phrase/fingerprint).
                        // `if` (not `visible:`) leaves no layout gap on the Lobby.
                        if root.active != 0 : PillButton {
                            label: "Details"; w: 88px;
                            clicked => { root.sheet-open = true; }
                        }
                        SealedPill { }
                    }
                }
                // tab strip
                Rectangle {
                    height: 38px; background: #0b0c0e;
                    HorizontalLayout {
                        padding-left: 16px; spacing: 20px;
                        TabLabel { label: "Chat"; active: root.active-tab == 0; clicked => { root.active-tab = 0; } }
                        TabLabel { label: "Public Shares"; active: root.active-tab == 1; clicked => { root.active-tab = 1; root.shares-tab-opened(); } }
                        TabLabel { label: "Circle shares"; active: root.active-tab == 2; clicked => { root.active-tab = 2; } }
                        TabLabel { label: "Announcements"; active: root.active-tab == 3; clicked => { root.active-tab = 3; root.announcements-tab-opened(); } }
                        Rectangle { }
                    }
                }
                Rectangle { height: 1px; background: #ffffff10; }

                // Restore notice — tab-INDEPENDENT so it is seen from the Chat landing
                // view (felt-test 2026-06-21: was Shares-tab-only via share-status →
                // the user lands on Chat and never saw it). Persists until dismissed; no timeout.
                if root.connect-notice != "" : Rectangle {
                    height: 30px; background: #11302b; border-width: 1px; border-color: #1f4d45;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; spacing: 10px;
                        Text { text: root.connect-notice; color: #6fb3a4; font-size: 12px; vertical-alignment: center; }
                        Rectangle { }
                        TouchArea {
                            width: 22px;
                            Text { text: "✕"; color: #6fb3a4; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            clicked => { root.connect-notice = ""; }
                        }
                    }
                }

                // body — content region swaps by tab; composer bar is ALWAYS
                // instantiated (so it is a stable autofocus target) but shown only
                // on the Chat tab.
                Rectangle {
                    background: #07080a;
                    VerticalLayout {
                        // content region (one tab visible at a time)
                        chat-area := Rectangle {
                            // CHAT — message list
                            if root.active-tab == 0 : Flickable {
                                viewport-width: self.width;
                                // #86: real laid-out content height (variable-height bubbles),
                                // not a fixed per-message stride. Mirrored into root.chat-content-h
                                // so the #84 at-bottom test can use it (root can't see into this `if`).
                                viewport-height: chat-content.preferred-height;
                                viewport-y <=> root.scroll-y;
                                property <length> content-h: chat-content.preferred-height;
                                init => { root.chat-content-h = self.content-h; }
                                changed content-h => { root.chat-content-h = self.content-h; }
                                chat-content := VerticalLayout {
                                    padding: 16px; spacing: 8px;
                                    for m in root.messages : MsgBubble { who: m.who; text: m.text; mine: m.mine; }
                                }
                            }

                            // SHARES — public-share browse tree (commit 1). The pane
                            // IS the file browser (demonsaw-4.20 reference): a header
                            // row (title · status · Refresh) over a full-height,
                            // scrollable, OS-style tree. Each relay share is a root
                            // node; expanding lazily previews its files. Download
                            // (right-click) + publish (overlay) are commits 2 & 3.
                            if root.active-tab == 1 : VerticalLayout {
                                // No `alignment: start` — that packs children to their
                                // preferred height and would zero out the tree's
                                // `vertical-stretch`. Default fill lets the tree expand.
                                padding: 14px; spacing: 10px;
                                HorizontalLayout {
                                    height: 38px;
                                    spacing: 10px;
                                    Text { text: "Public Shares"; color: #e4e8ee; font-size: 15px; vertical-alignment: center; }
                                    Text { text: "· right-click an item to download"; color: #4d5560; font-size: 11px; vertical-alignment: center; }
                                    Text { text: root.share-status; color: #5b6472; font-size: 12px; vertical-alignment: center; }
                                    Rectangle { }
                                    PillButton { label: "Manage shares"; primary: true; w: 140px; clicked => { root.open-publish(); } }
                                    PillButton { label: "Refresh"; w: 96px; clicked => { root.refresh-shares(); } }
                                }
                                // the tree fills the rest of the pane
                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: 10px; background: #0b0c0e; border-width: 1px; border-color: #ffffff10;
                                    Flickable {
                                        width: 100%; height: 100%;
                                        viewport-width: self.width;
                                        viewport-height: root.share-rows.length * 30px + 12px;
                                        VerticalLayout {
                                            padding: 6px; alignment: start;
                                            for r in root.share-rows : ShareTreeRow {
                                                node: r;
                                                toggled(id) => { root.toggle-share-node(id); }
                                                downloadable(id) => { root.download-node(id); }
                                            }
                                        }
                                    }
                                    // empty-state — computed visibility (never an `if`),
                                    // centered over the empty tree.
                                    Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: root.shares-empty-hint;
                                        visible: root.share-rows.length == 0;
                                        color: #5b6472; font-size: 13px; horizontal-alignment: center;
                                    }
                                }
                            }

                            // CIRCLE SHARES — placeholder so nav feels complete (M17, not built)
                            if root.active-tab == 2 : VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center; spacing: 8px;
                                        Text { text: "Circle shares"; color: #aeb6c2; font-size: 18px; horizontal-alignment: center; }
                                        Text { text: "work in progress · coming soon"; color: #5b6472; font-size: 13px; horizontal-alignment: center; }
                                        Text { text: "End-to-end-encrypted sharing inside a circle."; color: #3f4651; font-size: 12px; horizontal-alignment: center; }
                                    }
                                }
                            }

                            // ANNOUNCEMENTS + MOTD (#91) — display-only, the connected
                            // relay's verbatim MOTD over its client-re-verified
                            // announcement posts. The MOTD area hides when unset
                            // (ISC-S9); the posts list shows an empty-state otherwise.
                            if root.active-tab == 3 : VerticalLayout {
                                padding: 14px; spacing: 10px;
                                HorizontalLayout {
                                    height: 28px; spacing: 10px;
                                    Text { text: "Announcements"; color: #e4e8ee; font-size: 15px; vertical-alignment: center; }
                                    Text { text: "· this relay"; color: #4d5560; font-size: 11px; vertical-alignment: center; }
                                    Text { text: root.announce-status; color: #5b6472; font-size: 12px; vertical-alignment: center; }
                                    Rectangle { }
                                    PillButton { label: "Refresh"; w: 96px; clicked => { root.announcements-tab-opened(); } }
                                }
                                // MOTD — hidden when unset (computed `if`, not a stale box).
                                if root.motd != "" : Rectangle {
                                    border-radius: 10px; background: #11302b; border-width: 1px; border-color: #1f4d45;
                                    VerticalLayout {
                                        padding: 12px; spacing: 4px;
                                        Text { text: "Message of the day"; color: #6fb3a4; font-size: 11px; font-weight: 600; }
                                        Text { text: root.motd; color: #d6dae1; font-size: 13px; wrap: word-wrap; }
                                    }
                                }
                                // announcements list fills the rest of the pane.
                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: 10px; background: #0b0c0e; border-width: 1px; border-color: #ffffff10;
                                    Flickable {
                                        width: 100%; height: 100%;
                                        viewport-width: self.width;
                                        viewport-height: ann-list.preferred-height;
                                        ann-list := VerticalLayout {
                                            padding: 8px; spacing: 8px; alignment: start;
                                            for a in root.announcements : AnnouncementRowView {
                                                topic: a.topic; body: a.body; ts: a.ts;
                                            }
                                        }
                                    }
                                    // empty-state — computed visibility (never an `if`).
                                    Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: root.announcements-empty-hint;
                                        visible: root.announcements.length == 0;
                                        color: #5b6472; font-size: 13px; horizontal-alignment: center;
                                    }
                                }
                                // (#92) signer-gated composer — present ONLY for a
                                // whitelisted signer (`can-compose`, set on snapshot,
                                // not by typing → an `if` here is safe). A non-signer
                                // never sees it, so the pane stays read-only.
                                if root.can-compose : VerticalLayout {
                                    spacing: 8px;
                                    Rectangle { height: 1px; background: #ffffff14; }
                                    Text { text: "Compose — you can post here"; color: #6fb3a4; font-size: 12px; font-weight: 600; }
                                    // MOTD setter — single line, plaintext (ISC-S9).
                                    Rectangle {
                                        height: 40px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                                        HorizontalLayout { padding-left: 12px;
                                            Text { text: "Set MOTD (single line, plain text)"; visible: root.compose-motd == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                                        }
                                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                            motd_input := MenuTextInput {
                                                text <=> root.compose-motd;
                                                accepted => { root.set-motd(root.compose-motd); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        Rectangle { }
                                        PillButton { label: "Set MOTD"; w: 110px; clicked => { root.set-motd(root.compose-motd); } }
                                    }
                                    // Announcement composer — topic + body.
                                    Rectangle {
                                        height: 40px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                                        HorizontalLayout { padding-left: 12px;
                                            Text { text: "Topic"; visible: root.compose-topic == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                                        }
                                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                            topic_input := MenuTextInput {
                                                text <=> root.compose-topic;
                                                accepted => { body_input.focus-input(); }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 40px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                                        HorizontalLayout { padding-left: 12px;
                                            Text { text: "Announcement body"; visible: root.compose-body == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                                        }
                                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                            body_input := MenuTextInput {
                                                text <=> root.compose-body;
                                                accepted => { root.upload-announcement(root.compose-topic, root.compose-body); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        Rectangle { }
                                        PillButton { label: "Post announcement"; primary: true; w: 180px; clicked => { root.upload-announcement(root.compose-topic, root.compose-body); } }
                                    }
                                }
                            }
                        }

                        // composer bar — stable autofocus target; shown on Chat only.
                        Rectangle {
                            height: root.active-tab == 0 ? 54px : 0px;
                            visible: root.active-tab == 0;
                            background: #0d0e10;
                            HorizontalLayout {
                                padding: 12px; spacing: 10px;
                                Rectangle {
                                    // Fill the composer width (minus the Send button) and clip:
                                    // a long pasted single-line draft must scroll inside the box,
                                    // not grow the box and balloon the whole centre column.
                                    horizontal-stretch: 1;
                                    clip: true;
                                    border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12;
                                    // Explicit-positioned (not a content-sizing layout): a single-line
                                    // TextInput reports its full text as its minimum width, so a layout
                                    // that sizes to it balloons the whole centre column on a long paste.
                                    // Binding the width to the box (parent) makes the field a fixed
                                    // viewport the text scrolls within. `visible:` not `if` for the
                                    // placeholder — mutating the item tree mid-edit risks the
                                    // partial_renderer "RefCell already borrowed" crash.
                                    Text {
                                        x: 12px; width: parent.width - 24px; height: 100%;
                                        text: "Message the circle…";
                                        visible: root.draft == "";
                                        color: #4d5560;
                                        font-size: 13px; vertical-alignment: center;
                                    }
                                    composer := MenuTextInput {
                                        x: 12px; width: parent.width - 24px; height: 100%;
                                        text <=> root.draft;
                                        accepted => { root.send-message(root.draft); }
                                    }
                                }
                                Rectangle { width: 84px; height: 38px; border-radius: 9px; background: #4a9d8e;
                                    TouchArea { clicked => { root.send-message(root.draft); } }
                                    Text { text: "Send"; color: #06120f; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                    }
                }
            }
        }

        // ── RIGHT: live Lobby roster (#75) ── the people column. Per the presence
        // design-of-record the roster IS the indication: names appear when a heartbeat
        // arrives and vanish past TTL — no dots/badges/"last seen"/toasts. Shown only
        // for the Lobby Chat; the width collapses to 0 off-Lobby so chat reclaims the
        // space (circle presence is #77). Demonsaw's full-height roster pane.
        Rectangle {
            width: (root.active == 0 && root.active-tab == 0) ? 1px : 0px;
            background: #ffffff12;
        }
        Rectangle {
            width: (root.active == 0 && root.active-tab == 0) ? 240px : 0px;
            visible: root.active == 0 && root.active-tab == 0;
            background: #0d0e10;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                // Centered over the pane + brighter/larger (caraka accessibility pass).
                Text { text: "HERE NOW"; color: #c8ced6; font-size: 14px; horizontal-alignment: center; }
                Rectangle { height: 1px; background: #ffffff14; }
                Rectangle {
                    vertical-stretch: 1;
                    Flickable {
                        width: 100%; height: 100%;
                        viewport-width: self.width;
                        viewport-height: root.roster.length * 46px + 8px;
                        VerticalLayout {
                            padding: 2px; spacing: 2px; alignment: start;
                            for r in root.roster : RosterRowView { name: r.name; fingerprint: r.fingerprint; }
                        }
                    }
                    // empty-state — computed visibility (never an `if`), centered; brighter/larger.
                    Text {
                        x: (parent.width - self.width) / 2; y: 16px;
                        text: "No one else here yet";
                        visible: root.roster.length == 0;
                        color: #9aa3b0; font-size: 14px; horizontal-alignment: center; wrap: word-wrap;
                    }
                }
            }
        }
    }

    // ── context sheet overlay (on-demand) ──
    sheet := Rectangle {
        y: 0; width: 340px; height: root.height;
        x: root.sheet-open ? root.width - self.width : root.width;
        // `visible:`-gated so the pane isn't permanently mounted off-screen (a
        // resize-flash source); it exists only while open. `sheet-open` is `in-out`
        // so the header Details button opens it and the Close button dismisses it.
        visible: root.sheet-open;
        animate x { duration: 220ms; easing: ease-in-out; }
        background: #101113; border-width: 1px; border-color: #ffffff14;
        VerticalLayout {
            padding: 16px; spacing: 10px; alignment: start;
            HorizontalLayout {
                Text { text: "Circle details"; color: #e4e8ee; font-size: 15px; vertical-alignment: center; }
                Rectangle { }
                PillButton { label: "Close"; w: 70px; clicked => { root.sheet-open = false; root.hide-phrase(); } }
            }
            Text { text: "end-to-end encrypted"; color: #6fb3a4; font-size: 12px; }
            Text { text: "members — identity only, no presence"; color: #5b6472; font-size: 12px; }

            // ── #36 name vectors (hidden for the Lobby — all three blank) ──
            if root.circle-name != "" : VerticalLayout {
                spacing: 2px;
                Text { text: "Name"; color: #5b6472; font-size: 11px; }
                Text { text: root.circle-name; color: #cfd5dd; font-size: 13px; }
            }
            if root.circle-relay-label != "" : VerticalLayout {
                spacing: 2px;
                Text { text: "Relay name (matches only on this relay)"; color: #5b6472; font-size: 11px; wrap: word-wrap; }
                Text { text: root.circle-relay-label; color: #cfd5dd; font-size: 13px; }
            }
            if root.circle-fingerprint != "" : VerticalLayout {
                spacing: 2px;
                Text { text: "Fingerprint (verify out-of-band — same everywhere)"; color: #5b6472; font-size: 11px; wrap: word-wrap; }
                Text { text: root.circle-fingerprint; color: #cfd5dd; font-size: 13px; }
            }

            // ── #115 phrase reveal (passphrase-gated) + leave (real circles only) ──
            if root.circle-fingerprint != "" : VerticalLayout {
                spacing: 8px;
                Rectangle { height: 1px; background: #ffffff12; }
                // The revealed phrase — Rust sets it ONLY after a verified passphrase.
                // `visible:` not `if` so revealing/hiding never mutates the item tree.
                Text {
                    text: "Join phrase — anyone with it can read & post";
                    visible: root.circle-phrase-revealed != "";
                    color: #5b6472; font-size: 11px; wrap: word-wrap;
                }
                Text {
                    text: root.circle-phrase-revealed;
                    visible: root.circle-phrase-revealed != "";
                    color: #cfd5dd; font-size: 13px; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // One button: "Show join phrase" (opens the passphrase prompt) before
                    // a reveal, "Copy phrase" (to clipboard) after.
                    PillButton {
                        label: root.circle-phrase-revealed == "" ? "Show join phrase" : "Copy phrase";
                        w: 160px;
                        clicked => {
                            if (root.circle-phrase-revealed == "") {
                                root.phrase-prompt-pass = "";
                                root.phrase-prompt-open = true;
                                root.focus-phrase-pass-input();
                            } else {
                                root.copy-phrase();
                            }
                        }
                    }
                    Rectangle { }
                    PillButton { label: "Leave circle"; w: 130px; clicked => { root.leave-confirm-open = true; } }
                }
            }
        }
    }

    // ── command palette overlay — the action registry mirrored to a 2nd surface ──
    palette := Rectangle {
        x: (root.width - self.width) / 2; y: 90px;
        width: 520px; height: 320px;
        visible: root.palette-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 14px; spacing: 8px; alignment: start;
            Rectangle { height: 36px; border-radius: 8px; background: #141517;
                HorizontalLayout { padding-left: 10px; Text { text: "Type a command…"; color: #aeb6c2; font-size: 13px; vertical-alignment: center; } } }
            for a[i] in root.actions : Rectangle {
                height: 30px; border-radius: 6px; background: #121315;
                TouchArea {
                    clicked => {
                        root.palette-open = false;
                        // Action registry → real behavior. 0 = Lobby, 1 = New
                        // circle, 2 = Join a circle, 3 = Fetch a share (open the
                        // Shares tab + refresh the catalog), 4 = About overlay,
                        // 5 = Announcements (open the pane + fetch this relay's news),
                        // 6 = Rename identity (open the rename overlay, #66).
                        if (i == 0) { root.switch-circle(0); }
                        if (i == 1) { root.open-new(); }
                        if (i == 2) { root.open-join(); }
                        if (i == 3) { root.active-tab = 1; root.shares-tab-opened(); }
                        if (i == 4) { root.about-open = true; }
                        if (i == 5) { root.active-tab = 3; root.announcements-tab-opened(); }
                        if (i == 6) { root.open-rename(); }
                    }
                }
                HorizontalLayout { padding-left: 10px; spacing: 8px;
                    Text { text: a.label; color: #cfd5dd; font-size: 13px; vertical-alignment: center; }
                    Rectangle { }
                    Text { text: a.shortcut; color: #aeb6c2; font-size: 13px; font-weight: 600; vertical-alignment: center; } }
            }
        }
        // Backend-independent dismiss: Ctrl-K/Escape die on the winit Windows
        // backend (#58), so a clickable close-X is the reliable exit path.
        Rectangle {
            x: parent.width - self.width - 10px; y: 10px;
            width: 26px; height: 26px; border-radius: 6px;
            background: palette-close.has-hover ? #ffffff14 : transparent;
            palette-close := TouchArea { clicked => { root.palette-open = false; root.focus-composer(); } }
            Text { text: "×"; color: #aeb6c2; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // ── About overlay (#59) — version / project / license / repo readout. The
    // Close pill is a mouse dismiss path (Windows-safe, like join/new). ──
    about := Rectangle {
        x: (root.width - self.width) / 2; y: 110px;
        width: 440px; height: 250px;
        visible: root.about-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 22px; spacing: 10px; alignment: start;
            HorizontalLayout {
                Text { text: "daemonseed"; color: #e4e8ee; font-size: 19px; vertical-alignment: center; }
                Rectangle { }
                Text { text: root.app-version; color: #4a9d8e; font-size: 15px; vertical-alignment: center; }
            }
            Text { text: "Federated, end-to-end-encrypted comms & file sharing."; color: #8b93a1; font-size: 13px; }
            Rectangle { height: 1px; background: #ffffff12; }
            HorizontalLayout {
                Text { text: "License"; color: #5b6472; font-size: 13px; }
                Rectangle { }
                Text { text: "AGPL-3.0-or-later"; color: #cfd5dd; font-size: 13px; }
            }
            HorizontalLayout {
                Text { text: "Source"; color: #5b6472; font-size: 13px; }
                Rectangle { }
                Text { text: "github.com/caraka/daemonseed"; color: #cfd5dd; font-size: 13px; }
            }
            Rectangle { }
            HorizontalLayout {
                Rectangle { }
                PillButton { label: "Close"; w: 80px; clicked => { root.about-open = false; root.focus-composer(); } }
            }
        }
    }

    // ── Rename-identity overlay (#66) — set/change the display name on the existing
    // identity, then re-seal. Reachable for a nameless profile too (the #65 recovery
    // path). The cryptographic identity (the handle hash) never changes; only the
    // presented name does. Cancel + Save are mouse dismiss paths (Windows-safe). ──
    rename := Rectangle {
        x: (root.width - self.width) / 2; y: 110px;
        width: 460px; height: 240px;
        visible: root.rename-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: "Rename identity"; color: #e4e8ee; font-size: 17px; }
                Rectangle { }
                PillButton { label: "Cancel"; w: 80px; clicked => { root.rename-open = false; root.focus-composer(); } }
            }
            Text { text: "Change the name others see. Your identity and circles are unchanged."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
            // name field — mirrors the Join phrase box (fixed width, clipped, single-line).
            Rectangle {
                height: 44px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                HorizontalLayout { padding-left: 12px;
                    // `visible:` not `if` — toggling on the first/last char typed must
                    // NOT mutate the item tree mid-edit (partial_renderer crash).
                    Text { text: "a name others will see…"; visible: root.rename-name == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                }
                HorizontalLayout { padding-left: 12px; padding-right: 12px;
                    rename_name_input := MenuTextInput {
                        text <=> root.rename-name;
                        accepted => { root.submit-rename(root.rename-name); }
                    }
                }
            }
            // inline error (invalid name / persist failure) — STABLE Text, no `if`.
            Text {
                text: root.rename-error;
                visible: root.rename-error != "";
                color: #c2785b; font-size: 12px;
            }
            Rectangle { }
            HorizontalLayout {
                Rectangle { }
                PillButton {
                    label: "Save name"; primary: true; w: 150px;
                    clicked => { root.submit-rename(root.rename-name); }
                }
            }
        }
    }

    // ── #115 passphrase prompt: gate the circle-phrase reveal (evil-maid guard) ──
    // The unlock passphrase is more sensitive than the phrase it reveals, so the input
    // is masked (input-type: password). On Reveal, Rust verifies and either fills
    // circle-phrase-revealed (the sheet then shows it + a Copy button) or sets the error.
    phrase_prompt := Rectangle {
        x: (root.width - self.width) / 2; y: 110px;
        width: 460px; height: 230px;
        visible: root.phrase-prompt-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: "Show join phrase"; color: #e4e8ee; font-size: 17px; }
                Rectangle { }
                PillButton { label: "Cancel"; w: 80px; clicked => { root.phrase-prompt-open = false; root.phrase-prompt-pass = ""; root.focus-composer(); } }
            }
            Text { text: "Enter your passphrase to reveal this circle's join phrase."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
            Rectangle {
                height: 44px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                HorizontalLayout { padding-left: 12px;
                    Text { text: "passphrase…"; visible: root.phrase-prompt-pass == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                }
                HorizontalLayout { padding-left: 12px; padding-right: 12px;
                    phrase_pass_input := MenuTextInput {
                        input-type: password;
                        text <=> root.phrase-prompt-pass;
                        accepted => { root.reveal-phrase(root.phrase-prompt-pass); }
                    }
                }
            }
            Text { text: root.phrase-prompt-error; visible: root.phrase-prompt-error != ""; color: #c2785b; font-size: 12px; }
            Rectangle { }
            HorizontalLayout {
                Rectangle { }
                PillButton { label: "Reveal"; primary: true; w: 130px; clicked => { root.reveal-phrase(root.phrase-prompt-pass); } }
            }
        }
    }

    // ── #115 leave-circle confirm: leaving is easy, but acknowledge the phrase is saved ──
    leave_confirm := Rectangle {
        x: (root.width - self.width) / 2; y: 130px;
        width: 440px; height: 200px;
        visible: root.leave-confirm-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 20px; spacing: 14px; alignment: start;
            Text { text: "Leave this circle?"; color: #e4e8ee; font-size: 17px; }
            Text { text: "You'll need its join phrase to rejoin — make sure you've saved it. There is no recovery."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
            Rectangle { }
            HorizontalLayout {
                spacing: 10px;
                PillButton { label: "Cancel"; w: 100px; clicked => { root.leave-confirm-open = false; } }
                Rectangle { }
                PillButton {
                    label: "Leave circle"; primary: true; w: 150px;
                    clicked => { root.leave-confirm-open = false; root.sheet-open = false; root.leave-circle(); }
                }
            }
        }
    }

    // ── Join-a-circle overlay (brief "Join a circle" screen) ──
    join := Rectangle {
        x: (root.width - self.width) / 2; y: 70px;
        width: 540px; height: 420px;
        visible: root.join-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 18px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: "Join a circle"; color: #e4e8ee; font-size: 17px; }
                Rectangle { }
                PillButton { label: "Close"; w: 70px; clicked => { root.join-open = false; root.focus-composer(); } }
            }
            Text { text: "Enter the phrase you were given."; color: #8b93a1; font-size: 13px; }

            HorizontalLayout {
                spacing: 10px;
                // phrase field
                Rectangle {
                    // Fixed width: this box lives in a HorizontalLayout, so without an
                    // explicit width the inner TextInput's content width propagates up
                    // and the box grows past `clip`. Overlay is 540px (padding 18·2 →
                    // 504 inner) minus the 120px QR slot and 10px spacing = 374px.
                    width: 374px;
                    height: 44px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true; // contain a long single-line entry inside the box
                    HorizontalLayout { padding-left: 12px;
                        // `visible:` not `if` — toggling on the first/last char typed
                        // must NOT mutate the item tree mid-edit (partial_renderer crash).
                        Text { text: "the words you agreed on…"; visible: root.join-phrase == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                    }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px;
                        // Right-click context menu (#67). `custom-paste` routes the Paste
                        // item to the #63 `paste-into-join` path (clipboard read + strength
                        // refresh + refocus), so that behavior is preserved while Cut /
                        // Copy / Select all come from the field's own backend clipboard.
                        join_phrase_input := MenuTextInput {
                            text <=> root.join-phrase;
                            custom-paste: true;
                            paste-requested => { root.paste-into-join(); }
                            edited => { root.join-phrase-edited(root.join-phrase); }
                            accepted => { root.submit-join(root.join-phrase); }
                        }
                    }
                }
                // co-equal QR slot (reserved) — same visual weight as the field.
                Rectangle {
                    width: 120px; height: 44px; border-radius: 9px; background: #101113; border-width: 1px; border-color: #ffffff12;
                    Text { text: "Scan QR · soon"; color: #5b6472; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            // quiet strength reassurance (no number) / calm weak recovery — a STABLE
            // computed Text (no `if`), so editing the phrase never mutates the item
            // tree mid-edit (the partial_renderer "RefCell already borrowed" crash).
            HorizontalLayout {
                Text {
                    text: root.join-phrase-strong ? "Looks strong"
                        : root.join-phrase != "" ? "Keep adding words — a little longer." : "";
                    color: root.join-phrase-strong ? #6fb3a4 : #8b7d5b;
                    font-size: 12px; vertical-alignment: center;
                }
                Rectangle { }
            }

            // pre-commit confirmation card — client-verifiable facts only.
            Rectangle {
                border-radius: 10px; background: #101113; border-width: 1px; border-color: #ffffff10;
                VerticalLayout {
                    padding: 12px; spacing: 6px; alignment: start;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Before you enter"; color: #aeb6c2; font-size: 13px; vertical-alignment: center; }
                        Rectangle { }
                        SealedPill { }
                    }
                    // PLACEHOLDER — caraka security review: the crypto/relay facts on
                    // this card are a security-reviewed artifact (brief refinement #3,
                    // D6). Wording is NOT improvised unattended; these lines are
                    // structural stand-ins to be replaced with verified claims.
                    Text { text: "End-to-end encrypted · only people with this phrase can read it."; color: #6fb3a4; font-size: 12px; }
                    Text { text: "[PLACEHOLDER — caraka security review: relay-exposure sentence]"; color: #5b6472; font-size: 11px; }
                    Text { text: "[PLACEHOLDER — caraka security review: \"N others\" only on a trusted relay]"; color: #5b6472; font-size: 11px; }
                }
            }

            Rectangle { }
            HorizontalLayout {
                Rectangle { }
                PillButton {
                    label: "Enter the circle"; primary: true; w: 160px;
                    clicked => { root.submit-join(root.join-phrase); }
                }
            }
        }
    }

    // ── First-run desktop-integration prompt (self-register .desktop + icon) ──
    // Shown only on the main screen and only when Rust flips desktop-prompt-open
    // (launched from an AppImage, not yet integrated, not declined). The whole reason
    // this exists: AppImages aren't "installed", so the dock shows a generic icon until
    // a .desktop is registered. See src/desktop_integration.rs (universal / XDG).
    desktop-prompt := Rectangle {
        x: (root.width - self.width) / 2; y: 90px;
        width: 460px; height: 224px;
        visible: root.desktop-prompt-open && root.screen == "main";
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            Text { text: "Add Daemonseed to your applications?"; color: #e4e8ee; font-size: 16px; }
            Text {
                text: "Adds it to your app menu and dock with its icon. You can undo this anytime; nothing else is installed.";
                color: #8b93a1; font-size: 13px; wrap: word-wrap;
            }
            Text {
                text: root.desktop-prompt-status;
                color: #6fb3a4; font-size: 12px;
                visible: root.desktop-prompt-status != "";
            }
            Rectangle { }
            HorizontalLayout {
                spacing: 8px;
                PillButton { label: "Not now"; w: 88px; clicked => { root.desktop-dismiss(false); } }
                PillButton { label: "Don't ask again"; w: 140px; clicked => { root.desktop-dismiss(true); } }
                Rectangle { }
                PillButton { label: "Add"; primary: true; w: 80px; clicked => { root.desktop-integrate(); } }
            }
        }
    }

    // ── New-circle overlay (brief "New circle" screen) ──
    new-circle := Rectangle {
        x: (root.width - self.width) / 2; y: 70px;
        width: 540px; height: 380px;
        visible: root.new-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            padding: 18px; spacing: 12px; alignment: start;
            HorizontalLayout {
                Text { text: "New circle"; color: #e4e8ee; font-size: 17px; }
                Rectangle { }
                PillButton { label: "Close"; w: 70px; clicked => { root.new-open = false; } }
            }
            Text { text: "Here's a strong phrase. Share it with members out-of-band."; color: #8b93a1; font-size: 13px; }

            // The generated phrase — an EDITABLE TextInput (two-way to `new-phrase`)
            // so a tester can edit / select / paste-overwrite it (delete, Ctrl-V).
            // The Copy button drives Slint's native clipboard (`select-all`+`copy`);
            // manual select + Ctrl-C is a fallback. Editing re-checks the (hidden)
            // strength so an edited-weak phrase loses the pill and is blocked.
            Rectangle {
                height: 64px; border-radius: 10px; background: #141517; border-width: 1px; border-color: #ffffff12;
                HorizontalLayout { padding: 14px;
                    new_phrase_input := MenuTextInput {
                        text <=> root.new-phrase;
                        font-size: 14px; wrap: word-wrap; single-line: false;
                        edited => { root.new-copied = false; root.new-phrase-edited(root.new-phrase); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                // STABLE status indicator — a single always-present element whose
                // text/color are COMPUTED from the booleans. Editing the phrase only
                // changes properties; it never adds/removes items, so the renderer's
                // item tree can't mutate mid-edit (the `if`-toggle version crashed
                // with a partial_renderer "RefCell already borrowed", caraka 2026-06-15).
                Text {
                    text: root.new-copied ? "✓ copied to clipboard"
                        : root.new-phrase-strong ? "Looks strong"
                        : root.new-phrase != "" ? "Keep adding words — a little longer." : "";
                    color: (root.new-copied || root.new-phrase-strong) ? #6fb3a4 : #8b7d5b;
                    font-size: 12px; vertical-alignment: center;
                }
                Rectangle { }
                // Select-all + copy to the system clipboard (Slint-native, via the
                // backend) + a visible confirmation. No-op was the felt-test blocker.
                PillButton {
                    label: "Copy"; w: 84px;
                    clicked => { new_phrase_input.select-all(); new_phrase_input.copy(); root.new-copied = true; }
                }
                PillButton { label: "Show QR"; w: 96px; clicked => { } }
                PillButton { label: "Re-roll"; w: 96px; clicked => { root.reroll-new(); } }
            }

            Rectangle { }
            HorizontalLayout {
                Rectangle { }
                PillButton {
                    label: "Create the circle"; primary: true; w: 170px;
                    clicked => { root.submit-new(root.new-phrase); }
                }
            }
        }
    }
    // ── Publish overlay (commit 3): publish a folder + manage your live shares ──
    publish := Rectangle {
        x: (root.width - self.width) / 2; y: 70px;
        width: 540px; height: 460px;
        visible: root.publish-open;
        background: #0e0f11; border-radius: 12px; border-width: 1px; border-color: #ffffff18;
        VerticalLayout {
            // No `alignment: start` — that packs children to preferred height and zeroes
            // the live-shares list's `vertical-stretch` (same trap as the Shares tab).
            padding: 18px; spacing: 12px;
            HorizontalLayout {
                Text { text: "Publish a folder"; color: #e4e8ee; font-size: 17px; }
                Rectangle { }
                PillButton { label: "Close"; w: 70px; clicked => { root.publish-open = false; } }
            }
            Text {
                text: "Pick a folder to share on the relay. It serves from disk for this session — closing the app or Unpublish stops it.";
                color: #8b93a1; font-size: 13px; wrap: word-wrap;
            }

            // optional name field (blank → the folder's own name)
            Rectangle {
                height: 44px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true; // contain a long single-line entry inside the box
                HorizontalLayout { padding-left: 12px;
                    // `visible:` not `if` — toggling on the first/last char typed must
                    // NOT mutate the item tree mid-edit (partial_renderer crash).
                    Text { text: "Name (optional — defaults to the folder name)"; visible: root.publish-name == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                }
                HorizontalLayout { padding-left: 12px; padding-right: 12px;
                    publish_name_input := MenuTextInput {
                        text <=> root.publish-name;
                        accepted => { root.submit-publish(root.publish-name); }
                    }
                }
            }
            HorizontalLayout {
                Rectangle { }
                PillButton {
                    label: "Choose folder & publish"; primary: true; w: 210px;
                    clicked => { root.submit-publish(root.publish-name); }
                }
            }

            // publish feedback: "Opening folder picker…" / "Published …" / the error
            // reason (e.g. "not connected to a relay yet"). `visible:` not `if` so a
            // status change never mutates the item tree mid-edit (partial_renderer).
            Text {
                text: root.publish-status;
                visible: root.publish-status != "";
                color: #8b93a1; font-size: 12px; wrap: word-wrap;
            }

            // "Your live shares" — published this session, each removable.
            Text { text: "Your live shares"; color: #aeb6c2; font-size: 13px; }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 10px; background: #0b0c0e; border-width: 1px; border-color: #ffffff10;
                Flickable {
                    width: 100%; height: 100%;
                    viewport-width: self.width;
                    viewport-height: root.my-shares.length * 40px + 12px;
                    VerticalLayout {
                        padding: 6px; alignment: start;
                        for s in root.my-shares : Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text { text: s.name; color: #e4e8ee; font-size: 13px; }
                                    Text { text: s.files + " file(s) · serving"; color: #5b6472; font-size: 11px; }
                                }
                                Rectangle { }
                                PillButton {
                                    label: "Unpublish"; w: 104px;
                                    clicked => { root.unpublish-share(s.id); }
                                }
                            }
                        }
                    }
                }
                // empty-state — computed visibility (never an `if`).
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Nothing published yet.";
                    visible: root.my-shares.length == 0;
                    color: #5b6472; font-size: 13px; horizontal-alignment: center;
                }
            }
        }
    }
    } // end key-host FocusScope (wraps main + overlays so Ctrl-K keeps working
      // even when an overlay field holds focus)

    // ── Round-6 auth gate: TWO full-window overlays, ON TOP of the shortcut host.
    // Toggled by `visible:` (NOT `if`) so switching to the shell HIDES rather than
    // DESTROYS them. Destroying a focused field's subtree (an `if` going false) re-
    // enters the partial_renderer's `free_graphics_resources` while `partial_cache`
    // is borrowed → "RefCell already borrowed" (partial_renderer.rs:818); caraka hit
    // this pressing Return on Unlock. Hiding never frees items, so no teardown, no
    // crash. Always-instantiated ⇒ the field ids are reachable for deferred
    // autofocus. Outside key-host so their fields don't trip the global Ctrl shortcuts.

    // ── Daily-login Unlock ──
    unlock-screen := Rectangle {
        visible: root.screen == "unlock";
        width: 100%; height: 100%;
        background: #07080a;
        Rectangle {
            x: (parent.width - self.width) / 2; y: 70px;
            width: 560px; height: 470px;
            background: #0e0f11; border-radius: 14px; border-width: 1px; border-color: #ffffff18;
            VerticalLayout {
                padding: 26px; spacing: 14px; alignment: start;
                HorizontalLayout {
                    Text { text: "daemonseed"; color: #aeb6c2; font-size: 18px; vertical-alignment: center; }
                    Rectangle { }
                    SealedPill { }
                }
                Text { text: "Welcome back"; color: #e4e8ee; font-size: 21px; }
                Text { text: "Enter your passphrase to unlock this device."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
                Rectangle {
                    height: 46px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12;
                    clip: true; // contain a long single-line entry inside the box
                    HorizontalLayout { padding-left: 12px;
                        Text { text: "passphrase"; visible: root.unlock-passphrase == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                    }
                    HorizontalLayout { padding-left: 12px; padding-right: 12px;
                        unlock_input := MenuTextInput {
                            text <=> root.unlock-passphrase;
                            input-type: InputType.password;
                            font-size: 14px;
                            accepted => { root.unlock-submit(root.unlock-passphrase); }
                        }
                    }
                }
                Text { text: root.auth-error; color: #c0857d; font-size: 12px; }
                Rectangle { }
                HorizontalLayout {
                    Rectangle { }
                    PillButton { label: "Unlock"; primary: true; w: 130px; clicked => { root.unlock-submit(root.unlock-passphrase); } }
                }
            }
        }
    }

    // ── First-start enrollment wizard ──
    //
    // The 4 steps OVERLAP inside a content area (each `visible: fs-step == N`, all
    // at the same x/y filling the area) instead of `if`-mounting — so a step change
    // is a visibility flip, never an item-tree teardown, and the fields are never
    // destroyed (same crash-avoidance as the unlock overlay).
    firststart-screen := Rectangle {
        visible: root.screen == "first-start";
        width: 100%; height: 100%;
        background: #07080a;
        Rectangle {
            x: (parent.width - self.width) / 2; y: 70px;
            width: 560px; height: 470px;
            background: #0e0f11; border-radius: 14px; border-width: 1px; border-color: #ffffff18;
            VerticalLayout {
                padding: 26px; spacing: 14px; alignment: start;
                HorizontalLayout {
                    Text { text: "daemonseed"; color: #aeb6c2; font-size: 18px; vertical-alignment: center; }
                    Rectangle { }
                    SealedPill { }
                }
                // Overlapping step content (Rectangle = no layout, children stack).
                Rectangle {
                    // step 0 — passphrase
                    VerticalLayout {
                        visible: root.fs-step == 0;
                        x: 0; y: 0; width: 100%; height: 100%;
                        spacing: 12px; alignment: start;
                        Text { text: "Create your identity"; color: #e4e8ee; font-size: 21px; }
                        Text { text: "Choose a passphrase. It encrypts everything on this device — there is no reset, so make it strong and memorable."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
                        Rectangle {
                            height: 46px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12;
                            clip: true; // contain a long single-line entry inside the box
                            HorizontalLayout { padding-left: 12px;
                                Text { text: "a passphrase you'll remember"; visible: root.fs-passphrase == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                            }
                            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                fs_pass_input := MenuTextInput {
                                    text <=> root.fs-passphrase;
                                    input-type: InputType.password;
                                    font-size: 14px;
                                    edited => { root.fs-passphrase-edited(root.fs-passphrase); }
                                    accepted => { fs_pass_confirm_input.focus-input(); }
                                }
                            }
                        }
                        // Confirm re-entry — there is no recovery flow yet, so a typo in
                        // the passphrase above would silently lock this identity out
                        // forever. The two must match before Continue proceeds (checked
                        // Rust-side in `fs-passphrase-next`).
                        Rectangle {
                            height: 46px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12;
                            clip: true; // contain a long single-line entry inside the box
                            HorizontalLayout { padding-left: 12px;
                                Text { text: "re-enter it to confirm"; visible: root.fs-passphrase-confirm == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                            }
                            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                fs_pass_confirm_input := MenuTextInput {
                                    text <=> root.fs-passphrase-confirm;
                                    input-type: InputType.password;
                                    font-size: 14px;
                                    accepted => { root.fs-passphrase-next(); }
                                }
                            }
                        }
                        Text {
                            text: root.fs-passphrase-strong ? "Looks strong"
                                : root.fs-passphrase != "" ? "Add a few more words." : "";
                            color: root.fs-passphrase-strong ? #6fb3a4 : #8b7d5b;
                            font-size: 12px;
                        }
                        Text { text: root.auth-error; color: #c0857d; font-size: 12px; }
                        Rectangle { }
                        HorizontalLayout {
                            Rectangle { }
                            PillButton { label: "Continue"; primary: true; w: 130px; clicked => { root.fs-passphrase-next(); } }
                        }
                    }

                    // step 1 — recovery phrase
                    VerticalLayout {
                        visible: root.fs-step == 1;
                        x: 0; y: 0; width: 100%; height: 100%;
                        spacing: 12px; alignment: start;
                        Text { text: "Your recovery phrase"; color: #e4e8ee; font-size: 21px; }
                        Text { text: "Write these words down and keep them somewhere safe. They are the ONLY way to recover this identity."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
                        Rectangle {
                            height: 110px; border-radius: 10px; background: #141517; border-width: 1px; border-color: #ffffff12;
                            HorizontalLayout { padding: 14px;
                                fs_mnemonic_box := TextInput {
                                    text: root.fs-mnemonic;
                                    read-only: true;
                                    color: #d6dae1; font-size: 14px; wrap: word-wrap; vertical-alignment: top; single-line: false;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PillButton { label: "Copy"; w: 84px; clicked => { fs_mnemonic_box.select-all(); fs_mnemonic_box.copy(); } }
                            Rectangle { }
                            PillButton { label: "I've saved it"; primary: true; w: 150px; clicked => { root.fs-saved-next(); } }
                        }
                    }

                    // step 2 — C34 type-back confirm (3 words by position)
                    VerticalLayout {
                        visible: root.fs-step == 2;
                        x: 0; y: 0; width: 100%; height: 100%;
                        spacing: 12px; alignment: start;
                        Text { text: "Confirm your backup"; color: #e4e8ee; font-size: 21px; }
                        Text { text: root.fs-typeback-prompt; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
                        // Three single-word boxes (ISC-C34): one challenge word each,
                        // Enter advances to the next (the third confirms). One word per
                        // box retires the single-field trailing-space nit.
                        HorizontalLayout {
                            spacing: 8px; min-height: 56px;
                            Rectangle {
                                border-radius: 10px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                                HorizontalLayout { padding: 12px;
                                    fs_confirm_1 := MenuTextInput {
                                        text <=> root.fs-confirm-1;
                                        font-size: 14px;
                                        accepted => { fs_confirm_2.focus-input(); }
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: 10px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                                HorizontalLayout { padding: 12px;
                                    fs_confirm_2 := MenuTextInput {
                                        text <=> root.fs-confirm-2;
                                        font-size: 14px;
                                        accepted => { fs_confirm_3.focus-input(); }
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: 10px; background: #141517; border-width: 1px; border-color: #ffffff12; clip: true;
                                HorizontalLayout { padding: 12px;
                                    fs_confirm_3 := MenuTextInput {
                                        text <=> root.fs-confirm-3;
                                        font-size: 14px;
                                        accepted => { root.fs-confirm-next(); }
                                    }
                                }
                            }
                        }
                        Text { text: "Type each word in its own box, in order."; color: #8b7d5b; font-size: 12px; }
                        Text { text: root.auth-error; color: #c0857d; font-size: 12px; }
                        Rectangle { }
                        HorizontalLayout {
                            Rectangle { }
                            PillButton { label: "Confirm"; primary: true; w: 130px; clicked => { root.fs-confirm-next(); } }
                        }
                    }

                    // step 3 — display name
                    VerticalLayout {
                        visible: root.fs-step == 3;
                        x: 0; y: 0; width: 100%; height: 100%;
                        spacing: 12px; alignment: start;
                        Text { text: "Pick a display name"; color: #e4e8ee; font-size: 21px; }
                        Text { text: "This is how others see you in chats. You can be anyone."; color: #8b93a1; font-size: 13px; wrap: word-wrap; }
                        Rectangle {
                            height: 46px; border-radius: 9px; background: #141517; border-width: 1px; border-color: #ffffff12;
                            clip: true; // contain a long single-line entry inside the box
                            HorizontalLayout { padding-left: 12px;
                                Text { text: "a name others will see"; visible: root.fs-name == ""; color: #4d5560; font-size: 13px; vertical-alignment: center; }
                            }
                            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                fs_name_input := MenuTextInput {
                                    text <=> root.fs-name;
                                    font-size: 14px;
                                    accepted => { root.fs-finish(root.fs-name); }
                                }
                            }
                        }
                        Text { text: root.auth-error; color: #c0857d; font-size: 12px; }
                        Rectangle { }
                        HorizontalLayout {
                            Rectangle { }
                            PillButton { label: "Create my identity"; primary: true; w: 180px; clicked => { root.fs-finish(root.fs-name); } }
                        }
                    }
                }
            }
        }
    }

    // Build-version readout, gated to the auth surfaces so a tester can cite the
    // build before unlocking. Topmost child ⇒ draws over the opaque auth overlays.
    // The full About/Help home is issue #59.
    Text {
        text: root.app-version;
        visible: root.screen == "unlock" || root.screen == "first-start";
        color: #4d5560; font-size: 11px;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16px;
    }
}
